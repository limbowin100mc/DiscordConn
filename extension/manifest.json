{
  "manifest_version": 3,
  "name": "Presence Hub Connector",
  "version": "1.5.1",
  "description": "Lets the Presence Hub desktop app show the video, stream or song you have open as your Discord activity.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Presence Hub",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://open.spotify.com/*",
    "https://kick.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.netflix.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/common.js",
        "content/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content/common.js",
        "content/ytmusic.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content/media-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content/common.js",
        "content/spotify.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "content/common.js",
        "content/kick.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content/common.js",
        "content/x.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content/common.js",
        "content/netflix.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
